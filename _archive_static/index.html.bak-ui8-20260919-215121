<style>
  /* ============================================================
     Design Tokens — mirrors the regexproof marketing template.
     ============================================================ */
  :root{
    /* 颜色：主蓝 / 辅助蓝 / 中性灰阶 / 橙色强调 */
    --blue-50:#EFF6FF;  --blue-100:#DBEAFE; --blue-200:#BFDBFE;
    --blue-500:#3B82F6; --blue-600:#2563EB; --blue-700:#1D4ED8;
    --orange-50:#FFF7ED; --orange-600:#EA580C; --orange-700:#C2410C;

    --slate-50:#F8FAFC; --slate-100:#F1F5F9; --slate-200:#E2E8F0;
    --slate-300:#CBD5E1; --slate-400:#94A3B8; --slate-500:#64748B;
    --slate-600:#475569; --slate-700:#334155; --slate-800:#1E293B;
    --slate-900:#0F172A;

    --surface:#FFFFFF;        /* 主背景/留白 */
    --surface-alt:#F8FAFC;    /* 区块交替底色 */
    --text:#0F172A;           /* 主文本 */
    --text-secondary:#475569; /* 次级文本 (7.5:1 on #FFF) */
    --text-muted:#64748B;     /* 三级文本 (4.7:1 on #FFF, AA) */
    --border:#E2E8F0;
    --border-strong:#CBD5E1;

    /* 间距：8pt 栅格 */
    --space-1:4px;  --space-2:8px;  --space-3:12px; --space-4:16px;
    --space-5:24px; --space-6:32px; --space-8:48px; --space-10:64px; --space-12:96px;

    /* 字阶 */
    --fs-overline:12px; --fs-caption:14px; --fs-body:16px;
    --fs-h3:20px; --fs-h2:24px; --fs-h1:32px; --fs-display:40px;

    /* 圆角 */
    --radius-sm:6px; --radius-md:10px; --radius-lg:16px; --radius-pill:999px;

    /* 阴影 */
    --shadow-sm:0 1px 2px rgba(15,23,42,.06),0 1px 3px rgba(15,23,42,.08);
    --shadow-md:0 4px 6px -2px rgba(15,23,42,.06),0 10px 15px -3px rgba(15,23,42,.10);
    --shadow-lg:0 10px 25px -5px rgba(15,23,42,.12),0 8px 10px -6px rgba(15,23,42,.06);

    /* 字体栈：系统字体，零依赖（含等宽回退） */
    --font-sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
    --font-mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,"Liberation Mono",monospace;

    --container:1120px;
    --header-h:64px;
  }

  /* ============================================================ Reset */
  *,*::before,*::after{box-sizing:border-box;}
  html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;}
  body{margin:0;font-family:var(--font-sans);font-size:var(--fs-body);line-height:1.6;
       color:var(--text);background:var(--surface);-webkit-font-smoothing:antialiased;}
  h1,h2,h3,h4,p,figure,ul,ol{margin:0;}
  ul,ol{padding:0;list-style:none;}
  a{color:var(--blue-700);text-decoration:none;}
  a:hover{text-decoration:underline;}
  img,svg{display:block;max-width:100%;}
  button{font:inherit;color:inherit;cursor:pointer;}

  /* ============================================================ A11y */
  .skip-link{position:absolute;left:var(--space-4);top:-100px;z-index:200;
    background:var(--blue-700);color:#fff;padding:10px 16px;border-radius:var(--radius-md);
    transition:top .2s ease;}
  .skip-link:focus{top:var(--space-4);}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;
    clip:rect(0,0,0,0);white-space:nowrap;border:0;}
  :focus-visible{outline:3px solid var(--blue-600);outline-offset:2px;border-radius:var(--radius-sm);}
  .focus-ring{box-shadow:0 0 0 3px var(--blue-200);}

  /* ============================================================ Layout */
  .container{width:100%;max-width:var(--container);margin-inline:auto;padding-inline:var(--space-4);}
  .section{padding-block:var(--space-10);}
  .section--alt{background:var(--surface-alt);}
  .section-head{max-width:680px;margin-bottom:var(--space-8);}
  .eyebrow{display:inline-flex;align-items:center;gap:var(--space-2);
    font-size:var(--fs-overline);font-weight:700;letter-spacing:.08em;text-transform:uppercase;
    color:var(--blue-700);background:var(--blue-50);padding:6px 12px;border-radius:var(--radius-pill);}
  .eyebrow::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--orange-600);}
  h1,h2,h3{line-height:1.2;color:var(--slate-900);font-weight:800;letter-spacing:-.01em;}
  h1{font-size:var(--fs-display);}
  h2{font-size:var(--fs-h2);}
  h3{font-size:var(--fs-h3);font-weight:700;}
  .lead{font-size:var(--fs-h3);color:var(--text-secondary);line-height:1.5;margin-top:var(--space-4);}
  .section-head p{color:var(--text-secondary);margin-top:var(--space-4);font-size:var(--fs-caption);}
  .measure{max-width:65ch;}

  /* ============================================================ Buttons */
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--space-2);
    min-height:44px;padding:0 22px;border:1px solid transparent;border-radius:var(--radius-md);
    font-size:var(--fs-body);font-weight:600;line-height:1;white-space:nowrap;
    transition:background .18s ease,border-color .18s ease,transform .18s ease,box-shadow .18s ease;}
  .btn:hover{text-decoration:none;}
  .btn-primary{background:var(--blue-600);color:#fff;}
  .btn-primary:hover{background:var(--blue-700);}
  .btn-secondary{background:var(--surface);color:var(--blue-700);border-color:var(--border-strong);}
  .btn-secondary:hover{background:var(--slate-50);border-color:var(--slate-400);}
  .btn-ghost{background:transparent;color:var(--blue-700);min-height:44px;padding:0 12px;}
  .btn-ghost:hover{color:var(--blue-700);text-decoration:underline;}
  .btn-lg{min-height:52px;padding:0 28px;font-size:var(--fs-h3);}
  .btn:active{transform:translateY(1px);}

  /* ============================================================ Header */
  .site-header{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.92);
    backdrop-filter:saturate(180%) blur(8px);border-bottom:1px solid transparent;
    transition:box-shadow .2s ease,border-color .2s ease;}
  .site-header.scrolled{box-shadow:var(--shadow-sm);border-color:var(--border);}
  .nav{display:flex;align-items:center;justify-content:space-between;height:var(--header-h);}
  .brand{display:inline-flex;align-items:center;gap:var(--space-2);font-weight:800;
    font-size:var(--fs-h3);color:var(--slate-900);letter-spacing:-.02em;}
  .brand:hover{text-decoration:none;}
  .brand .logo{width:32px;height:32px;flex:none;}
  .nav-links{display:none;align-items:center;gap:var(--space-2);}
  .nav-links a.nav-link{display:inline-flex;align-items:center;min-height:44px;padding:0 12px;
    color:var(--slate-700);font-weight:600;font-size:var(--fs-caption);border-radius:var(--radius-md);}
  .nav-links a.nav-link:hover{background:var(--slate-50);text-decoration:none;color:var(--slate-900);}
  .nav-links a[aria-current="page"]{color:var(--blue-700);}
  .nav-actions{display:flex;align-items:center;gap:var(--space-2);}
  .hamburger{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;
    border:1px solid var(--border-strong);border-radius:var(--radius-md);background:var(--surface);}
  .hamburger svg{width:22px;height:22px;}
  .mobile-menu{display:none;flex-direction:column;gap:var(--space-1);padding:var(--space-3) var(--space-4) var(--space-5);
    border-bottom:1px solid var(--border);background:var(--surface);box-shadow:var(--shadow-md);}
  .mobile-menu.open{display:flex;}
  .mobile-menu a{display:flex;align-items:center;min-height:48px;padding:0 12px;border-radius:var(--radius-md);
    color:var(--slate-700);font-weight:600;}
  .mobile-menu a:hover{background:var(--slate-50);text-decoration:none;}
  .mobile-menu a[aria-current="page"]{color:var(--blue-700);background:var(--blue-50);}
  .mobile-menu .btn{width:100%;margin-top:var(--space-2);}

  /* ============================================================ Hero */
  .hero{padding-block:var(--space-12) var(--space-10);}
  .hero-grid{display:grid;gap:var(--space-8);align-items:center;}
  .hero-cta{display:flex;flex-wrap:wrap;gap:var(--space-3);margin-top:var(--space-6);}
  .hero-trust{display:flex;flex-wrap:wrap;gap:var(--space-4) var(--space-6);align-items:center;
    margin-top:var(--space-8);color:var(--text-muted);font-size:var(--fs-caption);}
  .hero-trust .stars{color:var(--orange-600);letter-spacing:2px;}
  .hero-visual{background:linear-gradient(135deg,var(--slate-900),#1E293B);
    border-radius:var(--radius-lg);padding:var(--space-5);box-shadow:var(--shadow-lg);color:#fff;
    font-family:var(--font-mono);}
  .hero-visual .term{display:flex;gap:8px;align-items:center;color:var(--slate-400);font-size:13px;margin-bottom:var(--space-3);}
  .hero-visual .term .dot{width:10px;height:10px;border-radius:50%;}
  .hero-visual .term .dot.r{background:#EF4444;} .hero-visual .term .dot.y{background:#F59E0B;} .hero-visual .term .dot.g{background:#22C55E;}
  .hero-visual .label{color:#94A3B8;font-size:12px;margin:14px 0 6px;}
  .hero-visual .code{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
    border-radius:var(--radius-md);padding:12px 14px;font-size:14px;line-height:1.7;color:#E2E8F0;white-space:pre-wrap;word-break:break-word;}
  .hero-visual .code .hi{color:#7DD3FC;} .hero-visual .code .ok{color:#86EFAC;} .hero-visual .code .mut{color:#94A3B8;}

  /* ============================================================ Logos / flavors */
  .flavors{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:var(--space-6) var(--space-8);}
  .flavors .flavor-item{font-weight:800;font-size:var(--fs-h3);color:var(--slate-400);letter-spacing:-.02em;
    display:inline-flex;align-items:center;gap:var(--space-2);}
  .flavors .flavor-item svg{width:24px;height:24px;}

  /* ============================================================ Features */
  .grid-3{display:grid;gap:var(--space-5);}
  .card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);
    padding:var(--space-6);box-shadow:var(--shadow-sm);transition:box-shadow .2s ease,transform .2s ease;}
  .card:hover{box-shadow:var(--shadow-md);transform:translateY(-2px);}
  .feature-icon{width:48px;height:48px;border-radius:var(--radius-md);background:var(--blue-50);
    color:var(--blue-600);display:inline-flex;align-items:center;justify-content:center;margin-bottom:var(--space-4);}
  .feature-icon svg{width:24px;height:24px;}
  .feature-icon.accent{background:var(--orange-50);color:var(--orange-700);}
  .card h3{margin-bottom:var(--space-2);}
  .card p{color:var(--text-secondary);font-size:var(--fs-caption);}

  /* ============================================================ How it works */
  .steps{display:grid;gap:var(--space-6);counter-reset:step;}
  .step{display:flex;gap:var(--space-4);align-items:flex-start;}
  .step .num{flex:none;width:44px;height:44px;border-radius:var(--radius-pill);background:var(--blue-600);color:#fff;
    display:inline-flex;align-items:center;justify-content:center;font-weight:800;font-size:var(--fs-h3);}
  .step h3{margin-bottom:var(--space-1);}
  .step p{color:var(--text-secondary);font-size:var(--fs-caption);}

  /* ============================================================ Use cases */
  .usecase{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);
    padding:var(--space-6);box-shadow:var(--shadow-sm);display:flex;flex-direction:column;gap:var(--space-3);}
  .usecase .uc-tag{font-size:var(--fs-overline);font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--orange-700);}
  .usecase h3{font-size:var(--fs-h3);}
  .usecase .prompt{font-size:var(--fs-caption);color:var(--text-secondary);}
  .usecase .regex{font-family:var(--font-mono);font-size:13px;background:var(--slate-900);color:#7DD3FC;
    border-radius:var(--radius-md);padding:12px 14px;overflow-x:auto;white-space:pre;}

  /* ============================================================ CTA band */
  .cta-band{background:linear-gradient(135deg,var(--blue-600),var(--blue-700));
    border-radius:var(--radius-lg);padding:var(--space-10) var(--space-6);text-align:center;color:#fff;
    box-shadow:var(--shadow-lg);}
  .cta-band h2{color:#fff;}
  .cta-band p{color:rgba(255,255,255,.88);margin-top:var(--space-3);font-size:var(--fs-h3);}
  .cta-band .btn-primary{background:#fff;color:var(--blue-700);}
  .cta-band .btn-primary:hover{background:var(--blue-50);}
  .cta-band .btn-secondary{background:transparent;color:#fff;border-color:rgba(255,255,255,.5);}
  .cta-band .btn-secondary:hover{background:rgba(255,255,255,.12);border-color:#fff;}
  .cta-band .hero-cta{justify-content:center;margin-top:var(--space-6);}

  /* ============================================================ Pricing teaser */
  .teaser{display:flex;flex-wrap:wrap;gap:var(--space-5);justify-content:center;}
  .teaser .plan{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);
    padding:var(--space-6);box-shadow:var(--shadow-sm);width:280px;text-align:center;}
  .teaser .plan.featured{border-color:var(--blue-600);box-shadow:var(--shadow-md);}
  .teaser .plan h3{font-size:var(--fs-h3);}
  .teaser .plan .price{font-size:40px;font-weight:800;color:var(--slate-900);margin:var(--space-3) 0;}
  .teaser .plan .price small{font-size:var(--fs-caption);font-weight:600;color:var(--text-muted);}
  .teaser .plan p{color:var(--text-secondary);font-size:var(--fs-caption);}

  /* ============================================================ Footer */
  .site-footer{background:var(--slate-900);color:var(--slate-300);padding-block:var(--space-10) var(--space-6);}
  .footer-grid{display:grid;gap:var(--space-8);}
  .footer-grid .brand{color:#fff;}
  .footer-about{color:var(--slate-400);font-size:var(--fs-caption);max-width:38ch;margin-top:var(--space-3);}
  .footer-col h4{color:#fff;font-size:var(--fs-caption);text-transform:uppercase;letter-spacing:.06em;margin-bottom:var(--space-3);}
  .footer-col a{display:inline-flex;min-height:36px;align-items:center;color:var(--slate-400);font-size:var(--fs-caption);}
  .footer-col a:hover{color:#fff;text-decoration:none;}
  .footer-bottom{display:flex;flex-wrap:wrap;gap:var(--space-3);justify-content:space-between;align-items:center;
    border-top:1px solid rgba(255,255,255,.1);margin-top:var(--space-8);padding-top:var(--space-5);
    font-size:var(--fs-caption);color:var(--slate-500);}
  .footer-bottom a{color:var(--slate-400);}

  /* ============================================================ Responsive */
  @media (min-width:640px){
    .container{padding-inline:var(--space-6);}
  }
  @media (min-width:768px){
    .nav-links{display:flex;}
    .hamburger{display:none;}
    .hero-grid{grid-template-columns:1.05fr .95fr;}
    .steps{grid-template-columns:repeat(3,1fr);}
  }
  @media (min-width:1024px){
    .section{padding-block:var(--space-12);}
    .grid-3{grid-template-columns:repeat(3,1fr);}
    .usecases{grid-template-columns:repeat(3,1fr);}
    .footer-grid{grid-template-columns:2fr 1fr 1fr 1fr;}
    h1{font-size:48px;}
    h2{font-size:var(--fs-h1);}
  }
  @media (prefers-reduced-motion:reduce){
    *{animation:none!important;transition:none!important;scroll-behavior:auto!important;}
  }
