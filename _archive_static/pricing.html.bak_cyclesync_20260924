  /* ===== Pricing ===== */
  .billing-toggle{display:inline-flex;align-items:center;gap:var(--space-2);margin-top:var(--space-6);
    background:var(--slate-100);border-radius:var(--radius-pill);padding:var(--space-1);}
  .billing-toggle button{border:none;background:transparent;color:var(--slate-600);font-weight:700;
